# Copy to .env and change every value before running docker compose.
CLICKHOUSE_USER=siem
CLICKHOUSE_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
# Optional: require "Authorization: Bearer <token>" on POST /v1/ingest
SIEM_INGEST_TOKEN=
# Optional alert sinks
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_SECRET=
SIEM_SLACK_WEBHOOK_URL=
SIEM_LOG_LEVEL=info
